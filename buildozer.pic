[app]

title = Sam NG
package.name = samng
package.domain = org.samng

source.dir = .
source.include_exts = py,kv,png,jpg,json,txt
source.exclude_dirs = .git,.github,bin,.buildozer

version = 0.1

requirements = python3,kivy

orientation = portrait
fullscreen = 0

android.api = 35
android.minapi = 23
android.archs = arm64-v8a

android.permissions = INTERNET

android.debug_artifact = apk

[buildozer]

log_level = 2
warn_on_root = 1
